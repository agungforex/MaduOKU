//@version=5
strategy("EMA 74/200 + BB 20 Breakout Strategy (Gold & Bitcoin)", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05)

// ───────────────────────────── Inputs ─────────────────────────────
grpTrend = "Trend Filter (EMA)"
emaFastLen = input.int(74, "EMA Fast", group=grpTrend)
emaSlowLen = input.int(200, "EMA Slow", group=grpTrend)
filterMode = input.string("Position (EMA74 vs EMA200)", "Filter mode",
     options=["Position (EMA74 vs EMA200)", "Slope (EMA74 arah)", "Keduanya (AND)"], group=grpTrend)

grpBB = "Bollinger Bands 20"
bbLen = input.int(20, "BB Length", group=grpBB)
bbMult = input.float(2.0, "BB StdDev Multiplier (k)", step=0.1, group=grpBB)

grpExit = "Exit"
exitMode = input.string("Balik ke Basis", "Exit condition",
     options=["Balik ke Basis", "Trend berbalik", "Keduanya (OR)"], group=grpExit)

// ───────────────────────────── Core series ─────────────────────────────
// EMA: EMA_t = alpha*Close_t + (1-alpha)*EMA_{t-1}, alpha = 2/(len+1)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// BB20: Basis = SMA20, Upper/Lower = Basis +- k*StdDev20
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)

// Trend filter: posisi EMA74 vs EMA200, dan/atau slope EMA74
trendPos = math.sign(emaFast - emaSlow)
trendSlope = math.sign(emaFast - emaFast[1])

trendUp = filterMode == "Position (EMA74 vs EMA200)" ? trendPos == 1 :
          filterMode == "Slope (EMA74 arah)" ? trendSlope == 1 :
          trendPos == 1 and trendSlope == 1

trendDown = filterMode == "Position (EMA74 vs EMA200)" ? trendPos == -1 :
            filterMode == "Slope (EMA74 arah)" ? trendSlope == -1 :
            trendPos == -1 and trendSlope == -1

// ───────────────────────────── Entry: breakout BB20 ─────────────────────────────
// Long : close tembus ke atas Upper (baru pertama kali), searah trend naik
// Short: close tembus ke bawah Lower (baru pertama kali), searah trend turun
breakoutUp = close > bbUpper and close[1] <= bbUpper[1]
breakoutDown = close < bbLower and close[1] >= bbLower[1]

longSignal = breakoutUp and trendUp
shortSignal = breakoutDown and trendDown

// ───────────────────────────── Orders ─────────────────────────────
if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)

// ───────────────────────────── Exit ─────────────────────────────
exitLongBasis = close < bbBasis
exitShortBasis = close > bbBasis
exitLongTrend = trendDown
exitShortTrend = trendUp

exitLong = exitMode == "Balik ke Basis" ? exitLongBasis :
           exitMode == "Trend berbalik" ? exitLongTrend :
           exitLongBasis or exitLongTrend

exitShort = exitMode == "Balik ke Basis" ? exitShortBasis :
            exitMode == "Trend berbalik" ? exitShortTrend :
            exitShortBasis or exitShortTrend

if strategy.position_size > 0 and exitLong
    strategy.close("Long", comment="Exit long")

if strategy.position_size < 0 and exitShort
    strategy.close("Short", comment="Exit short")

// ───────────────────────────── Plots ─────────────────────────────
plot(emaFast, "EMA 74", color=color.new(color.orange, 0), linewidth=2)
plot(emaSlow, "EMA 200", color=color.new(color.blue, 0), linewidth=2)
p1 = plot(bbUpper, "BB Upper", color=color.new(color.gray, 40))
p2 = plot(bbLower, "BB Lower", color=color.new(color.gray, 40))
fill(p1, p2, color=color.new(color.gray, 90))
plot(bbBasis, "BB Basis", color=color.new(color.gray, 20))

bgcolor(trendUp ? color.new(color.green, 92) : trendDown ? color.new(color.red, 92) : na)

plotshape(longSignal, title="Long Entry", location=location.belowbar, style=shape.triangleup, color=color.green, size=size.small)
plotshape(shortSignal, title="Short Entry", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.small)
