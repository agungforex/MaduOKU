//@version=6
indicator("EMA 74/200 + BB 20 Signal", overlay=true)

// ---- Inputs ----
emaFastLen = input.int(74, "EMA Fast")
emaSlowLen = input.int(200, "EMA Slow")
bbLen = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB StdDev Multiplier (k)", step=0.1)

requireBOS = input.bool(true, "Signal valid hanya jika searah BOS terakhir", group="BOS Filter")
bosLookback = input.int(50, "BOS harus terjadi dalam N candle terakhir", group="BOS Filter")

sma5Len = input.int(5, "SMA Length (Signal 3)", group="Signal 3 - Extreme")

// ---- Core series ----
// EMA: EMA_t = alpha*Close_t + (1-alpha)*EMA_t-1, alpha = 2/(len+1)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// BB20: Basis = SMA20, Upper/Lower = Basis +- k*StdDev20
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)

// Slope EMA74 dan slope BB basis (arah kemiringan)
emaFastUp = emaFast > emaFast[1]
emaFastDown = emaFast < emaFast[1]
basisUp = bbBasis > bbBasis[1]
basisDown = bbBasis < bbBasis[1]

// ---- BOS (Break of Structure) dikonfirmasi struktur, fractal 5-bar (2 kiri, 2 kanan), validasi close ----
// Bullish BOS: swing high yang ditembus harus Lower High, dan swing low sebelumnya harus Lower Low.
// Bearish BOS: swing low yang ditembus harus Higher Low, dan swing high sebelumnya harus Higher High.
pivotHigh = ta.pivothigh(high, 2, 2)
pivotLow = ta.pivotlow(low, 2, 2)

var float sh1 = na
var float sh2 = na
var float sl1 = na
var float sl2 = na
var int bosDir = 0
var int bosBarIndex = na

if not na(pivotHigh)
    sh2 := sh1
    sh1 := pivotHigh
if not na(pivotLow)
    sl2 := sl1
    sl1 := pivotLow

bullishStructure = not na(sh1) and not na(sh2) and sh1 < sh2 and not na(sl1) and not na(sl2) and sl1 < sl2
bearishStructure = not na(sl1) and not na(sl2) and sl1 > sl2 and not na(sh1) and not na(sh2) and sh1 > sh2

if bullishStructure and close > sh1
    bosDir := 1
    bosBarIndex := bar_index
    sh1 := na
if bearishStructure and close < sl1
    bosDir := -1
    bosBarIndex := bar_index
    sl1 := na

bosFresh = not na(bosBarIndex) and (bar_index - bosBarIndex) <= bosLookback
bosBullish = not requireBOS or (bosFresh and bosDir == 1)
bosBearish = not requireBOS or (bosFresh and bosDir == -1)

// ---- Signal 1: breakout BB20 searah slope EMA74 ----
breakoutUp = close > bbUpper and close[1] <= bbUpper[1]
breakoutDown = close < bbLower and close[1] >= bbLower[1]

buySignal1 = breakoutUp and emaFastUp and bosBullish
sellSignal1 = breakoutDown and emaFastDown and bosBearish

// ---- Signal 2: cross garis tengah BB20, filter slope basis ATAU slope EMA74 searah ----
crossBasisUp = ta.crossover(close, bbBasis)
crossBasisDown = ta.crossunder(close, bbBasis)

buySignal2 = crossBasisUp and (basisUp or emaFastUp) and bosBullish
sellSignal2 = crossBasisDown and (basisDown or emaFastDown) and bosBearish

// ---- Signal 3: ekstrim SMA5(low/high) menembus BB20, murni mean-reversion (tanpa filter EMA74/BOS) ----
sma5Low = ta.sma(low, sma5Len)
sma5High = ta.sma(high, sma5Len)

buySignal3 = ta.crossunder(sma5Low, bbLower)
sellSignal3 = ta.crossover(sma5High, bbUpper)

// ---- Plots ----
plot(emaFast, "EMA 74", color=color.orange, linewidth=2)
plot(emaSlow, "EMA 200", color=color.blue, linewidth=2)
p1 = plot(bbUpper, "BB Upper", color=color.new(color.gray, 40))
p2 = plot(bbLower, "BB Lower", color=color.new(color.gray, 40))
fill(p1, p2, color=color.new(color.gray, 90))
plot(bbBasis, "BB Basis", color=color.new(color.gray, 20))

plotshape(buySignal1, title="Buy Signal 1", location=location.belowbar, style=shape.triangleup, color=color.green, size=size.small)
plotshape(sellSignal1, title="Sell Signal 1", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.small)

plotshape(buySignal2, title="Buy Signal 2", location=location.belowbar, style=shape.circle, color=color.lime, size=size.tiny)
plotshape(sellSignal2, title="Sell Signal 2", location=location.abovebar, style=shape.circle, color=color.maroon, size=size.tiny)

plotshape(buySignal3, title="Buy Signal 3", location=location.belowbar, style=shape.xcross, color=color.aqua, size=size.tiny)
plotshape(sellSignal3, title="Sell Signal 3", location=location.abovebar, style=shape.xcross, color=color.fuchsia, size=size.tiny)
